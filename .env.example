# Second Chance environment template. Copy to app/.env.local (Next.js loads it) or set
# these in Vercel. Never commit real values.

# --- PayPal (sandbox) ---
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_PRODUCT_ID=PROD-xxxxxxxxxxxx
PAYPAL_PLAN_PRO_ID=P-xxxxxxxxxxxx
PAYPAL_PLAN_LITE_ID=P-xxxxxxxxxxxx
PAYPAL_PLAN_SAVE50_ID=P-xxxxxxxxxxxx
PAYPAL_PLAN_WINBACK_ID=P-xxxxxxxxxxxx

# --- App ---
APP_BASE_URL=http://localhost:3000
# Neon/Postgres URL. Leave empty to use embedded PGlite in app/.data/pglite
DATABASE_URL=
# Protects /api/cron/resume (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# --- AI (any one is enough; with none, the rules engine is used) ---
OFFER_ENGINE=auto
NEBIUS_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Or any OpenAI-compatible endpoint:
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Models the AG Studio analyst may call (comma separated). Optional; default on Nebius is Qwen/Qwen3-30B-A3B-Instruct-2507.
STUDIO_AI_MODELS=
# Or a single-model override:
STUDIO_AI_MODEL=
# Abuse limits (optional; defaults shown). Counters live in the rate_limits table, IPs stored hashed.
LLM_IP_HOURLY_LIMIT=60
LLM_DAILY_LIMIT=1500
DEMO_IP_HOURLY_LIMIT=10

# --- Email via Resend (optional; without both, messages stay in the outbox) ---
RESEND_API_KEY=
EMAIL_FROM="Brightside Yoga <offers@secondchance.heyremind.ai>"
# Optional reply-to:
EMAIL_REPLY_TO=
# "Email this to me" limits for practice members (defaults shown)
EMAIL_IP_HOURLY_LIMIT=5
EMAIL_DAILY_LIMIT=50

# --- AG Grid / AG Studio (optional; without keys you get a watermark) ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
